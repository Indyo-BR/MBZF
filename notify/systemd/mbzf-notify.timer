[Unit]
Description=Fire the MBZF push scheduler on a schedule

[Timer]
# Every minute — class-start alerts need minute precision. Each run is a cheap
# oneshot (reads a couple of JSONs, only hits the network when something is due).
OnCalendar=*:0/1
# If the VPS was down at a trigger, run once on boot; the catch-up window in
# the script decides whether a missed moment still deserves a send.
Persistent=true
AccuracySec=10s

[Install]
WantedBy=timers.target
